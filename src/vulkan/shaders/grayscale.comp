#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) buffer InputBuffer { float inputData[]; };
layout(binding = 1) buffer OutputBuffer { float outputData[]; };

layout(push_constant) uniform PushConstants {
    float value;
    int width;
    int height;
    int channels;
} pc;

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;

    if (x >= pc.width || y >= pc.height) return;

    uint idx = (y * pc.width + x) * pc.channels;

    float gray = 0.299 * inputData[idx] + 0.587 * inputData[idx + 1] + 0.114 * inputData[idx + 2];
    outputData[idx] = gray;
    outputData[idx + 1] = gray;
    outputData[idx + 2] = gray;
    if (pc.channels == 4) {
        outputData[idx + 3] = inputData[idx + 3];
    }
}
