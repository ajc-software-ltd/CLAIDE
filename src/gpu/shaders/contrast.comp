#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) buffer InputBuffer { float inputData[]; };
layout(binding = 1) buffer OutputBuffer { float outputData[]; };

layout(push_constant) uniform PushConstants {
    float value;
    int width;
    int height;
    int channels;
} pc;

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;

    if (x >= pc.width || y >= pc.height) return;

    uint idx = (y * pc.width + x) * pc.channels;
    float factor = (259.0 * (pc.value + 255.0)) / (255.0 * (259.0 - pc.value));

    for (int c = 0; c < pc.channels; c++) {
        float v = factor * (inputData[idx + c] - 128.0) + 128.0;
        outputData[idx + c] = clamp(v, 0.0, 255.0);
    }
}
