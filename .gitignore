# CLIADE NotePad — .gitignore

# CMake build directories
cmake-build-debug/
cmake-build-release/
build/

# Compiled objects and binaries
*.o
*.a
*.so
*.dll
*.exe
*.out
*.pdb
*.ilk
*.lib

# CLion IDE
.idea/
*.iml

# Compilation database (generated by CMake)
compile_commands.json

# Log files
*.log
logs/

# Test temporary directories
cliade_tests/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor swap/backup files
*.swp
*.swo
*~
*.bak

# Sanitizer output
*.san

# Coverage reports
*.gcda
*.gcno
*.gcov
coverage/

# PDF reference docs (too large for git)
*.pdf
